# Watcher Configuration (.env)
# Copy to .env and customize as needed

# Folder to watch for new images
WATCH_UPLOADS_DIR=./uploads

# AI Service URL (local or remote)
AI_SERVICE_URL=http://localhost:8000

# Target split for incremental extraction (train/test)
TARGET_SPLIT=test

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log file path (leave empty to log to console only)
LOG_FILE=./logs/watcher.log

# Timeout for file stability check (seconds)
FILE_STABILITY_TIMEOUT=5

# Timeout for API request (seconds)
API_REQUEST_TIMEOUT=60

# Retry attempts for failed predictions
RETRY_ATTEMPTS=3

# Delay between retry attempts (seconds)
RETRY_DELAY=2
